generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  projects             ProjectMember[] @relation("ProjectMemberUser")
  assignedTasks        Task[]
  assignedProjectMembers ProjectMember[] @relation("MemberAssignments")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now())

  members     ProjectMember[]
  tasks Task[]
}

model ProjectMember {
  id               Int      @id @default(autoincrement())
  userId           Int
  projectId        Int
  role             String   @default("MEMBER")
  responsibility   String?
  status           String   @default("IN_SYNC")
  parentMemberId   Int?
  assignedById     Int?
  lastUpdateAt     DateTime @default(now())
  joinedAt         DateTime @default(now())

  user             User          @relation("ProjectMemberUser", fields: [userId], references: [id])
  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentMember     ProjectMember? @relation("MemberHierarchy", fields: [parentMemberId], references: [id])
  childMembers     ProjectMember[] @relation("MemberHierarchy")
  assignedBy       User?         @relation("MemberAssignments", fields: [assignedById], references: [id])

  @@unique([userId, projectId])
}

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("TODO")
  priority    String   @default("MEDIUM")
  projectId   Int
  assigneeId Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

 project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade) 
  assignee   User @relation(fields: [assigneeId], references: [id])
}